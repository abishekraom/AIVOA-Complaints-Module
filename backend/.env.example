# Copy this file to .env and fill in real values for your environment.
# Never commit the actual .env file.

# PostgreSQL 16 + pgvector connection string.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/complaints

# REQUIRED. Secret key used to sign JWT access tokens. There is no default:
# the application refuses to start unless this is set, in every environment
# including local development. Use a long, random, unique value per deployment.
JWT_SECRET=change-me-to-a-long-random-secret

# Optional overrides - shown with their current defaults from app/config.py.
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480
COMPLAINT_NUMBER_PREFIX=CMP
TRASH_RETENTION_DAYS=30
