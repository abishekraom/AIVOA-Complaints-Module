# Copy this file to .env and fill in real values for your environment.
# Never commit the actual .env file.

# PostgreSQL 16 + pgvector connection string.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5433/complaints

# Secret key used to sign JWT access tokens.
# IMPORTANT: the default in app/config.py is for local development only.
# Any real deployment (staging, production, or anything reachable outside
# your own machine) MUST override this with a long, random, unique secret.
JWT_SECRET=change-me-to-a-long-random-secret

# Optional overrides - shown with their current defaults from app/config.py.
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480
COMPLAINT_NUMBER_PREFIX=CMP
TRASH_RETENTION_DAYS=30
